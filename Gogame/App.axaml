<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gogame.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
		<FontFamily x:Key="OutfitFont">avares://Gogame/Assets/Fonts/Outfit#Outfit</FontFamily>
        <FontFamily x:Key="MaShanZhengFont">avares://Gogame/Assets/Fonts/Klee_One#Klee One</FontFamily>
    </Application.Resources>
</Application>
