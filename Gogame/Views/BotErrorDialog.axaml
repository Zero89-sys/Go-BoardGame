<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Gogame.BotErrorDialog"
        Title="BotErrorDialog"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="Transparent"
        SystemDecorations="None">

  <Border BorderBrush="#FF5555" BorderThickness="1" CornerRadius="8" Background="#191B1A">
        <StackPanel Margin="24" Spacing="16" VerticalAlignment="Center">
            
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="⚠️" FontSize="22" VerticalAlignment="Center"/>
                <TextBlock Text="Bot is Unavailable" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Foreground="#FF6B6B"
                           FontFamily="Georgia, 'Noto Serif', serif"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" 
                       Text="Failed to start the KataGo engine. Check if the 'Bot' folder contains the necessary files." 
                       Foreground="#E3E7EA" 
                       FontSize="14" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center"/>

            <Button Content="OK" 
                    Click="OnBackToMenu" 
                    Classes="end-button" 
                    Width="100" 
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
