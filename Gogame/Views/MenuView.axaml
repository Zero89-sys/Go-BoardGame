<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Gogame.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Gogame.Views.MenuView"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3D4A48" />
        <SolidColorBrush x:Key="TextBrush" Color="#D8DCDC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A9494"/>
        <SolidColorBrush x:Key="Void" Color="#141310"/>
        <SolidColorBrush x:Key="stone-white" Color="#EDE6D6"/>
        <SolidColorBrush x:Key="kaya-gold" Color="#B08D57"/>
        <SolidColorBrush x:Key="muted-kaya" Color="#8A7A5C"/>
        <SolidColorBrush x:Key="hanko-red" Color="#8E3B2F"/>

    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ===================== Button styles ===================== -->
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource OutfitFont}"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#332F3438"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Subtle lift + accent border on hover -->
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px) scale(1.015)"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource kaya-gold}"/>
            <Setter Property="Background" Value="#1E1A14"/>
        </Style>

        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource kaya-gold}"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(0.98)"/>
        </Style>

        <!-- ===================== Entrance animations ===================== -->
        <Style Selector="Border.title-wrap">
            <Style.Animations>
                <Animation Duration="0:0:0.9" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="-14"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Rectangle.title-rule">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.4" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    <!-- Stagger each menu button individually -->
    <Style Selector="Button.menu-item-1">
        <Style.Animations>
             <Animation Duration="0:0:0.5" Delay="0:0:0.07" FillMode="Forward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="16"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.menu-item-2">
        <Style.Animations>
            <Animation Duration="0:0:0.5" Delay="0:0:0.15" FillMode="Forward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="16"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.menu-item-3">
        <Style.Animations>
            <Animation Duration="0:0:0.5" Delay="0:0:0.12" FillMode="Forward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="16"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.menu-item-4">
        <Style.Animations>
            <Animation Duration="0:0:0.5" Delay="0:0:0.28" FillMode="Forward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="16"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.menu-item-5">
        <Style.Animations>
            <Animation Duration="0:0:0.5" Delay="0:0:0.35" FillMode="Forward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="16"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Animation for putting stone -->
    <Style Selector="Ellipse.ripple">
		<Style.Animations>
			<Animation Duration="0:0:3.5" IterationCount="Infinite" Easing="SineEaseOut">
                <KeyFrame Cue="0%">
					<Setter Property="Width" Value="16"/>
                    <Setter Property="Height" Value="16"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="Width" Value="140"/>
                    <Setter Property="Height" Value="140"/>
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    </UserControl.Styles>

    <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <RadialGradientBrush Center="15%, 0%" GradientOrigin="85%, 100%" Radius="0.9">
				<GradientStop Color="#2C2519" Offset="0"/>
                <GradientStop Color="#1C1712" Offset="0.45"/>
                <GradientStop Color="#120F0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Viewbox Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0, -60, -60" MaxWidth="600" MaxHeight="600">
        

      </Viewbox>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,120,0,0">
            <Border Classes="title-wrap">
                <TextBlock Text="囲碁"
                           FontSize="38" FontFamily="{StaticResource MaShanZhengFont}"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock.Effect>
						<DropShadowEffect Color="#000000" BlurRadius="24" OffsetX="0" OffsetY="4" Opacity="0.35"/>
                    </TextBlock.Effect>
                 </TextBlock>
            </Border>
            <Border Classes="title-wrap">
                <TextBlock Text="GO"
                 FontSize="140" FontFamily="{StaticResource OutfitFont}" FontWeight="Light"
                 Foreground="{StaticResource TextBrush}"
                 HorizontalAlignment="Center"/>
            </Border>
            <Rectangle Classes="title-rule" Height="1" Width="140" Fill="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0.5"
                       RenderTransformOrigin="60%,60%"/>
            <Ellipse Width="6" Height="6" Fill="#8E3B2F" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.85"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Classes="menu-list"
            Spacing="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,-80,0,0">
    <Button Classes="menu-item menu-item-1" Content="Player vs Player" Click="OnPlayervsPlayer"/>
    <Button x:Name="PlayerVsBotButton" Classes="menu-item menu-item-2" Content="Player vs Bot" Click="OnPlayerVsBotClick"/>
    <Button x:Name="PuzzleButton" Classes="menu-item menu-item-3" Content="Puzzles" Click="OnPuzzleClick"/>
    <Button x:Name="TutorialButton" Classes="menu-item menu-item-4" Content="Tutorial" Click="OnTutorialClick"/>
    <Button x:Name="ExitButton" Classes="menu-item menu-item-5" Content="Exit" Click="OnExit"/>
</StackPanel>

        <!-- Profile card -->
        <Button x:Name="ProfileButton"
                Grid.RowSpan="2"
                MinWidth="200"
                MaxWidth="280"
                Padding="16,14"
                Margin="0,28,32,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Stretch">

				<!-- Avatar -->
                <Grid ColumnDefinitions="Auto, *">
					<Border Width="50" 
                            Height="50"
                            CornerRadius="30"
                            ClipToBounds="True"
                            BorderBrush="{StaticResource muted-kaya}"
                            BorderThickness="1"
                            Background="#1D1914">

                        <!-- profile picture -->
                        <Image Source="avares://Gogame/Assets/default-avatar.jpg" Width="60" Height="60"/>
                    </Border>

                    <!-- Name -->
                    <StackPanel Grid.Column="1" 
                                Margin="14,0,0,0" 
                                VerticalAlignment="Center" 
                                Spacing="5">
						<TextBlock Text="Zero" 
                                   FontSize="20"
                                   FontWeight="Medium"
                                   FontFamily="{StaticResource OutfitFont}"
                                   Foreground="{StaticResource stone-white}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- rank -->
								<TextBlock Text="5 kyu" FontSize="12"
                                           FontFamily="{StaticResource OutfitFont}"
                                           Foreground="{StaticResource kaya-gold}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
        </Button>

        <TextBlock Text="v0.4" FontSize="18" Foreground="{StaticResource muted-kaya}"
                   Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"/>
    </Grid>
</UserControl>