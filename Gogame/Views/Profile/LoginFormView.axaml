<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Gogame.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Gogame.LoginFormView"
             x:DataType="vm:LoginFormViewModel">
    <UserControl.Styles>
    <StyleInclude Source="avares://Gogame/Styles/GameStyles.axaml"/>
   </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
		<Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1F2221" Offset="0"/>
                <GradientStop Color="#161817" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel>
			<Button x:Name="BackToMenu" Content="Back to Menu" Click="OnBackToMenu"
                        Classes="end-button" FontSize="18" HorizontalAlignment="Left" Margin="10"/>
        </StackPanel>  

        <Border Grid.Row="1" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="20,0,20,60" Padding="36,32"
                Background="#1A1C1B"
                BorderBrush="{StaticResource muted-kaya}" BorderThickness="1">

            <Grid>
		        <!-- Login form -->
                <StackPanel Spacing="14" IsVisible="{Binding IsLoginVisible}">
				    <StackPanel Spacing="8" Margin="0,0,0,10">
						<TextBlock Text="Sign in" FontSize="26" 
                                   FontFamily="Georgia, 'Noto Serif', serif"
                                   Foreground="{DynamicResource stone-white}"/>
                        <Rectangle Height="1" Width="40" HorizontalAlignment="Left"
                                   Fill="{DynamicResource kaya-gold}"/>
                    </StackPanel>

                    <TextBox Classes="field" Text="{Binding Email}" Watermark="E-mail" />
                    <TextBlock Text="{Binding EmailError}" Foreground="Red"
                               IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBox Classes="field" Text="{Binding Password}" Watermark="Password" PasswordChar='*'/>
                    <TextBlock Text="{Binding PasswordError}" Foreground="red"
                               IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBlock Text="{Binding GeneralError}" Foreground="Red"
                               IsVisible="{Binding GeneralError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <CheckBox Content="Remember me" IsChecked="{Binding RememberMe}"
                              FontFamily="Georgia, 'Noto Serif', serif"
                              Foreground="{DynamicResource stone-white}">
                        <CheckBox.Resources>
							<SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#8A7A5C" />
                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#B08D57" />
                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#D8DCDC" />
                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#3D4A48" />
                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#8A9494" />
                        </CheckBox.Resources>
                    </CheckBox>

                    <Button Classes="end-button" Content="Sign in" 
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Margin="0,8,0,0"/>

                    <!-- Switch for registration -->
                    <Button Content="Don't have an account? Register"
                            Classes="link-button"
                            Command="{Binding ToggleModeCommand}"/>
                </StackPanel>

                <!-- Register form -->
                <StackPanel Spacing="15" IsVisible="{Binding !IsLoginVisible}">
				    <StackPanel Spacing="8" Margin="0,0,0,10">
                        <TextBlock Text="Registration" FontSize="26" 
                                   FontFamily="Georgia, 'Noto Serif', serif"
                                   Foreground="{DynamicResource stone-white}"/>
                        <Rectangle Height="1" Width="40" HorizontalAlignment="Left"
                                   Fill="{DynamicResource kaya-gold}"/>
                    </StackPanel>

                    <TextBox Classes="field" Text="{Binding Username}" Watermark="Username"/>
                    <TextBlock Text="{Binding UsernameError}" Foreground="Red"
                               IsVisible="{Binding UsernameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <TextBox Classes="field" Text="{Binding Email}" Watermark="E-mail"/>
                    <TextBlock Text="{Binding EmailError}" Foreground="Red"
                               IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    
                    <TextBox Classes="field" Text="{Binding Password}" Watermark="Password" PasswordChar='*'/>
                    <TextBlock Text="{Binding PasswordError}" Foreground="Red"
                               IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBox Classes="field" Text="{Binding ConfirmPassword}" Watermark="Confirm password" PasswordChar='*'/>
                    <TextBlock Text="{Binding ConfirmPasswordError}" Foreground="Red"
                               IsVisible="{Binding ConfirmPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBlock Text="{Binding GeneralError}" Foreground="Red"
                               IsVisible="{Binding GeneralError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                     <Button Classes="end-button" Content="Register" 
                             Command="{Binding RegisterCommand}"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center" 
                             Margin="0,8,0,0"/>

                    <Button Classes="link-button" Content="Already have an account? Sign in"
                        Command="{Binding ToggleModeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
