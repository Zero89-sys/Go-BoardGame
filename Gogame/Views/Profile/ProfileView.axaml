<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Gogame.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Gogame.ProfileView"
             x:DataType="vm:ProfileViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://Gogame/Styles/GameStyles.axaml"/>
   </UserControl.Styles>

    <Grid>
		<Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1F2221" Offset="0"/>
                <GradientStop Color="#161817" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel>
			<Button x:Name="BackToMenu" Content="Back to Menu" Click="OnBackToMenu"
                        Classes="end-button" FontSize="18" HorizontalAlignment="Left" Margin="10"/>
        </StackPanel>  

    <ScrollViewer Margin="40">
      <Grid Width="1100" HorizontalAlignment="Center" Margin="40">
		<StackPanel Spacing="40" HorizontalAlignment="Stretch">
			<!-- Profile header -->
            <Grid ColumnDefinitions="Auto, *">
				<!-- Avatar -->
                <Grid Grid.Column="0" Width="90" Height="90" Margin="0,25,0,0">
					<Border CornerRadius="45" ClipToBounds="True" BorderBrush="{DynamicResource kaya-gold}" BorderThickness="1">
						<Image Source="{Binding Avatar}" Width="100" Height="100"/>
                    </Border>
                        <Image Source="avares://Gogame/Assets/avatar-frame.webp" Width="105" Height="105" IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12"  Margin="25">
					<!-- Name -->
                    <StackPanel Spacing="4">
						<TextBlock Text="{Binding Username}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource stone-white}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Joined October 2026" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="0 games played" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Bio}" FontSize="15" Foreground="{DynamicResource stone-white}"/>
                    </StackPanel>
                                    <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="10">
					<Button Classes="end-button" Content="Edit profile" Command="{Binding ToggleEditModeCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextBrush}" Padding="16, 8"/>
                    <Button Classes="end-button" Content="Share" Padding="16, 8"/>
                    <Button Classes="end-button" Content="Manage Users"  Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextBrush}" Padding="16,8"/>
                    <Button Classes="end-button" Command="{Binding LogoutCommand}" Content="Log out" Background="Transparent" Foreground="#D92D0D" Padding="16,8"/>
                </StackPanel>
             </StackPanel>
            </Grid>
            <TextBlock Text=". . ." HorizontalAlignment="Center" Foreground="{DynamicResource muted-kaya}" FontSize="50" LetterSpacing="4"/>

            <!-- Statistics -->
            <StackPanel Spacing="15">
				<TextBlock Text="STATS" FontSize="12" LetterSpacing="1" Foreground="{DynamicResource muted-kaya}"/>

                <!-- Stats grid -->
                <UniformGrid Rows="2" Columns="3">
                    <!-- Number of games -->
					<Border BorderBrush="{StaticResource muted-kaya}" BorderThickness="1" Padding="24" Background="Transparent">
                        <StackPanel Spacing="8">
							<TextBlock Text="{Binding GamesPlayed}" FontSize="28" Foreground="{DynamicResource stone-white}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
								<Ellipse Width="6" Height="6" Fill="{StaticResource kaya-gold}" VerticalAlignment="Center"/>
                                <TextBlock Text="Games played" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                   <!-- Win rate -->
                   <Border BorderBrush="{StaticResource muted-kaya}" BorderThickness="1" Padding="24" Background="Transparent">
					   <StackPanel Spacing="8">
						   <TextBlock Text="{Binding Winrate}" FontSize="28" Foreground="{DynamicResource stone-white}"/>
                           <StackPanel Orientation="Horizontal" Spacing="6">
							   <Ellipse Width="6" Height="6" Fill="{StaticResource kaya-gold}" VerticalAlignment="Center"/>
                               <TextBlock Text="Win rate" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                           </StackPanel>
                       </StackPanel>
                   </Border>
                   <!-- Current Rank -->
                   <Border BorderBrush="{StaticResource muted-kaya}" BorderThickness="1" Padding="24" Background="Transparent">
					   <StackPanel Spacing="8">
						   <TextBlock Text="{Binding CurrentRank}" FontSize="28" Foreground="{DynamicResource stone-white}"/>
                           <StackPanel Orientation="Horizontal" Spacing="6">
							   <Ellipse Width="6" Height="6" Fill="{StaticResource kaya-gold}" VerticalAlignment="Center"/>
                               <TextBlock Text="Current rank" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                           </StackPanel>
                       </StackPanel>
                   </Border>
                   <!-- Rank last 30 days  -->
                   <Border BorderBrush="{StaticResource muted-kaya}" BorderThickness="1" Padding="24" Background="Transparent">
					   <StackPanel Spacing="8">
						   <TextBlock Text="{Binding RankLast30Days}" FontSize="28" Foreground="{DynamicResource stone-white}"/>
                           <StackPanel Orientation="Horizontal" Spacing="6">
							   <Ellipse Width="6" Height="6" Fill="{StaticResource kaya-gold}" VerticalAlignment="Center"/>
                               <TextBlock Text="Rank last 30 days" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                           </StackPanel>
                       </StackPanel>
                   </Border>
                   <!-- Win streak -->
                   <Border BorderBrush="{StaticResource muted-kaya}" BorderThickness="1" Padding="24" Background="Transparent">
					   <StackPanel Spacing="8">
						   <TextBlock Text="{Binding WinStreak}" FontSize="28" Foreground="{DynamicResource stone-white}"/>
                           <StackPanel Orientation="Horizontal" Spacing="6">
							   <Ellipse Width="6" Height="6" Fill="{StaticResource kaya-gold}" VerticalAlignment="Center"/>
                               <TextBlock Text="Win streak" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                           </StackPanel>
                       </StackPanel>
                   </Border>
                   <!-- Puzzles solved -->
                   <Border BorderBrush="{StaticResource muted-kaya}" BorderThickness="1" Padding="24" Background="Transparent">
					   <StackPanel Spacing="8">
						   <TextBlock Text="{Binding PuzzlesSolved}" FontSize="28" Foreground="{DynamicResource stone-white}"/>
                           <StackPanel Orientation="Horizontal" Spacing="6">
							   <Ellipse Width="6" Height="6" Fill="{StaticResource kaya-gold}" VerticalAlignment="Center"/>
                               <TextBlock Text="Puzzles solved" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                           </StackPanel>
                       </StackPanel>
                   </Border>
                </UniformGrid>
            </StackPanel>
            <TextBlock Text=". . ." HorizontalAlignment="Center" Foreground="{DynamicResource muted-kaya}" FontSize="50" LetterSpacing="4"/>
            <!-- Recent games -->
            <StackPanel Spacing="15">
				<TextBlock Text="Recent games" FontSize="12" LetterSpacing="1" Foreground="{DynamicResource muted-kaya}"/>
                
                <!-- List of recent games -->
                <StackPanel>
                    <Border BorderBrush="{DynamicResource muted-kaya}" BorderThickness="0,0,0,0.5" Padding="0,14">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="vs. moss_walker" Foreground="{DynamicResource stone-white}" VerticalAlignment="Center"/>
                
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                <Border Background="{DynamicResource AccentBrush}" Padding="8,4" CornerRadius="3">
                                    <TextBlock Text="B+R" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                </Border>
                                <TextBlock Text="19×19" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Aug 9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="12" Width="40" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{DynamicResource muted-kaya}" BorderThickness="0,0,0,0.5" Padding="0,14">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="vs. KataBot (5d)" Foreground="{DynamicResource stone-white}" VerticalAlignment="Center"/>
                
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                <Border Background="{DynamicResource muted-kaya}" Padding="8,4" CornerRadius="3">
                                    <TextBlock Text="W+12.5" FontSize="11" Foreground="{DynamicResource Void}"/>
                                </Border>
                                <TextBlock Text="9×9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Aug 7" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="12" Width="40" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>

         <!-- Edit panel -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="400"
                Margin="20,0,20,60" 
                Padding="36,32"
                Background="#1A1C1B"
                BorderBrush="{StaticResource muted-kaya}" 
                BorderThickness="1"
                IsVisible="{Binding !EditModeHidden}">
			<StackPanel Spacing="14">
                <StackPanel Spacing="8" Margin="0,0,0,10">
						<TextBlock Text="Edit profile" FontSize="26" 
                                   FontFamily="Georgia, 'Noto Serif', serif"
                                   Foreground="{DynamicResource stone-white}"/>
                        <Rectangle Height="1" Width="40" HorizontalAlignment="Left"
                                   Fill="{DynamicResource kaya-gold}"/>
                </StackPanel>

                <!-- Avatar -->
				<Button Classes="avatar"
                        Background="Transparent" 
                        Margin="0,0,0,20"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Change avatar"
                        AutomationProperties.Name="Edit avatar">

                    <!-- Style for avatar button -->
                    <Button.Styles>
						<Style Selector="Button.avatar">
							<Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style Selector="Button.avatar:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="Button.avatar:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>

                        <Style Selector="Button.avatar Border.overlay">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Button.avatar:pointerover Border.overlay">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <Style Selector="Button.avatar:focus-visible Border.overlay">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </Button.Styles>

                    <!-- Avatar -->
                    <Border Width="100" Height="100"
                            CornerRadius="50"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource kaya-gold}"
                            BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>

                            <Border Classes="overlay"
                                    Background="#99000000"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Edit"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>
                <!-- Inputs -->
                <TextBox Classes="field" Text="{Binding Username}"/>
                <TextBox Classes="field" Text="{Binding Bio}" Watermark="Bio"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>

                <Button Classes="link-button" Content="Security settings →" Command="{Binding ToggleSecurityModeCommand}" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
                    <Button Classes="end-button"
                            Content="Cancel"  
                            Command="{Binding ToggleEditModeCommand}"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Background="Transparent" 
                            Foreground="{DynamicResource kaya-gold}" 
                            Margin="0,8,0,0"/>
                    <Button Classes="end-button" Content="Save changes" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
       </Border>

        <!-- Security mode -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="400"
                Margin="20,0,20,60" 
                Padding="36,32"
                Background="#1A1C1B"
                BorderBrush="{StaticResource muted-kaya}" 
                BorderThickness="1"
                IsVisible="{Binding !SecurityModeHidden}">
			<StackPanel Spacing="14">
                <StackPanel Spacing="8" Margin="0,0,0,10">
						<TextBlock Text="Security" FontSize="26" 
                                   FontFamily="Georgia, 'Noto Serif', serif"
                                   Foreground="{DynamicResource stone-white}"/>
                        <Rectangle Height="1" Width="40" HorizontalAlignment="Left"
                                   Fill="{DynamicResource kaya-gold}"/>
                </StackPanel>

                <!-- Inputs -->
                <TextBox Classes="field" Text="{Binding Email}"/>
                <TextBox Classes="field" Text="" Watermark="Password" PasswordChar='*'/>
                <TextBox Classes="field" Text="" Watermark="Confirm password" PasswordChar='*'/>

                <Button Classes="link-button" Content="← Back to edit profile" 
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleEditModeCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
                    <Button Classes="end-button"
                            Content="Cancel"  
                            Command="{Binding CloseAllCommand}"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Background="Transparent" 
                            Foreground="{DynamicResource kaya-gold}" 
                            Margin="0,8,0,0"/>
                    <Button Classes="end-button" Content="Save changes" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
       </Border>
     </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
