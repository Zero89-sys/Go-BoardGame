<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gogame.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Gogame.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Gogame.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Go.webp"
        Title="Go game">

        <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <TransitioningContentControl x:Name="MainContent" Content="{Binding CurrentView}" PageTransition="{x:Null}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.4"/>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <Rectangle x:Name="FadeOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False" ZIndex="999">
            <Rectangle.Transitions>
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                </Transitions>
            </Rectangle.Transitions>
        </Rectangle>
    </Grid>
</Window>
